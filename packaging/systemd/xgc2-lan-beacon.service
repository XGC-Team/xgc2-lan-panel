[Unit]
Description=XGC2 LAN Panel beacon (robot-side)
After=NetworkManager.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/xgc2/lan-beacon.env
ExecStart=/usr/bin/xgc2-lan-beacon
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=2

[Install]
WantedBy=multi-user.target
